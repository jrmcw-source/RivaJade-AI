    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences, handle, and AI prioritization learning profile",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\.]{3,40}$"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "defaultReminderMinutes": {
          "type": "number"
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "preferredFocusWindow": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "balanced"]
        },
        "prefersQuickWinsFirst": {
          "type": "boolean"
        },
        "behaviorSignals": {
          "type": "array",
          "description": "Bounded behavioral learning signals from user overrides and completion patterns"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "displayName",
        "username",
        "photoURL",
        "defaultReminderMinutes",
        "notificationsEnabled",
        "preferredFocusWindow",
        "prefersQuickWinsFirst",
