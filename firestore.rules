rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHandle(handle) {
      return handle is string && handle.size() >= 3 && handle.size() <= 40 && handle.matches('^[a-z0-9_\\.]+$');
    }

    function isValidCategory(category) {
      return category in [
        'Tax & Finance',
        'Car Maintenance',
        'Household',
        'Church & Faith',
        'Community Service',
        'Social Events',
        'Hobbies',
        'Health & Medical',
        'Wimberley Property',
        'General'
      ];
    }

    function isBoundedStringList(listVal, maxItems, maxItemLen) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= maxItemLen));
    }


    function isHouseholdMember(householdId) {
      return isSignedIn()
        && householdId is string
        && householdId.size() > 0
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function circleData(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data;
    }

    function existingHouseholdId() {
      return existing().get('householdId', '');
    }

    function existingMemberIds() {
      return existing().get('memberIds', []);
    }

    function canAccessRecord() {
      return existing().userId == request.auth.uid
        || (existingHouseholdId().size() > 0 && request.auth.uid in existingMemberIds());
    }

    // The audience stamp (Jason, 2026-11-20): the tags carry access.
    // memberIds is the audience snapshot; scope says how it was drawn —
    // private (the depositor alone), household (the household roster,
    // or a personal record with no household), family (the family
    // roster), or circles (the union of the tagged circles' members
    // plus the depositor). The depositor (userId) is always in the
    // audience and always the owner; a ring or a circle only holds.
    function isValidHouseholdStamp(data, kind) {
      return data.householdId is string
        && data.householdId.size() <= 128
        && isBoundedStringList(data.memberIds, 100, 128)
        && data.memberIds.size() >= 1
        && data.userId in data.memberIds
        && request.auth.uid in data.memberIds
        && audienceMatches(data, kind);
    }

    function audienceMatches(data, kind) {
      let scope = data.get('scope', 'household');
      return (scope == 'private' && data.memberIds.size() == 1)
        || (scope == 'household'
          && ((data.householdId == '' && data.memberIds.size() == 1)
            || (data.householdId.size() > 0
              && isValidId(data.householdId)
              && isHouseholdMember(data.householdId)
              && data.memberIds == householdData(data.householdId).memberIds)))
        || (scope == 'family' && familyAudienceMatches(data, kind))
        || (scope == 'circles'
          && data.get('circleIds', []).size() >= 1
          && data.get('circleIds', []).size() <= 4
          && circleAudienceMatches(data));
    }

    // Family audiences (Jason, 2026-11-21): each family's rules are
    // its own, set at the top of that family and working down. The
    // responsible age decides who is in the family's read/write
    // stream; the family doc carries the maintained lists
    // (notYetIds, childWriterIds) figured from its roster. Children
    // always see the family calendar, so a task's stamp is the full
    // roster — but a child may only write one when a parent has
    // granted it (childWriterIds). Everything else — money above
    // all — is stamped to the stream alone: everyone left out of
    // the stamp must be on the not-yet list, and a not-yet member
    // cannot write at all.
    function familyAudienceMatches(data, kind) {
      let fam = familyData(data.get('familyId', ''));
      let notYet = fam.get('notYetIds', []);
      return data.get('familyId', '').size() > 0
        && isValidId(data.get('familyId', ''))
        && request.auth.uid in fam.memberIds
        && data.memberIds.hasOnly(fam.memberIds)
        && (kind == 'tasks'
          ? (fam.memberIds.removeAll(data.memberIds).size() == 0
            && (!(request.auth.uid in notYet)
              || request.auth.uid in fam.get('childWriterIds', [])))
          : (fam.memberIds.removeAll(data.memberIds).hasOnly(notYet)
            && !(request.auth.uid in notYet)));
    }

    // Circle audiences are verified exactly, one unrolled size at a
    // time (rules have no loops): the snapshot must be the same set as
    // the depositor plus every tagged circle's members, and the writer
    // must belong to every circle they tag.
    function circleAudienceMatches(data) {
      let ids = data.get('circleIds', []);
      return (ids.size() == 1 && circleAudience1(data, ids))
        || (ids.size() == 2 && circleAudience2(data, ids))
        || (ids.size() == 3 && circleAudience3(data, ids))
        || (ids.size() == 4 && circleAudience4(data, ids));
    }

    function circleAudience1(data, ids) {
      let audience = [data.userId] + circleData(ids[0]).memberIds;
      let omitted = circleData(ids[0]).get('omitViewIds', []);
      return request.auth.uid in circleData(ids[0]).memberIds
        && !(request.auth.uid in circleData(ids[0]).get('omitWriteIds', []))
        && data.userId in data.memberIds
        && data.memberIds.hasOnly(audience)
        && audience.removeAll(data.memberIds).hasOnly(omitted);
    }

    function circleAudience2(data, ids) {
      let audience = [data.userId] + circleData(ids[0]).memberIds + circleData(ids[1]).memberIds;
      let omitted = circleData(ids[0]).get('omitViewIds', []) + circleData(ids[1]).get('omitViewIds', []);
      return request.auth.uid in circleData(ids[0]).memberIds
        && request.auth.uid in circleData(ids[1]).memberIds
        && !(request.auth.uid in circleData(ids[0]).get('omitWriteIds', []))
        && !(request.auth.uid in circleData(ids[1]).get('omitWriteIds', []))
        && data.userId in data.memberIds
        && data.memberIds.hasOnly(audience)
        && audience.removeAll(data.memberIds).hasOnly(omitted);
    }

    function circleAudience3(data, ids) {
      let audience = [data.userId] + circleData(ids[0]).memberIds + circleData(ids[1]).memberIds + circleData(ids[2]).memberIds;
      let omitted = circleData(ids[0]).get('omitViewIds', []) + circleData(ids[1]).get('omitViewIds', []) + circleData(ids[2]).get('omitViewIds', []);
      return request.auth.uid in circleData(ids[0]).memberIds
        && request.auth.uid in circleData(ids[1]).memberIds
        && request.auth.uid in circleData(ids[2]).memberIds
        && !(request.auth.uid in circleData(ids[0]).get('omitWriteIds', []))
        && !(request.auth.uid in circleData(ids[1]).get('omitWriteIds', []))
        && !(request.auth.uid in circleData(ids[2]).get('omitWriteIds', []))
        && data.userId in data.memberIds
        && data.memberIds.hasOnly(audience)
        && audience.removeAll(data.memberIds).hasOnly(omitted);
    }

    function circleAudience4(data, ids) {
      let audience = [data.userId] + circleData(ids[0]).memberIds + circleData(ids[1]).memberIds + circleData(ids[2]).memberIds + circleData(ids[3]).memberIds;
      let omitted = circleData(ids[0]).get('omitViewIds', []) + circleData(ids[1]).get('omitViewIds', []) + circleData(ids[2]).get('omitViewIds', []) + circleData(ids[3]).get('omitViewIds', []);
      return request.auth.uid in circleData(ids[0]).memberIds
        && request.auth.uid in circleData(ids[1]).memberIds
        && request.auth.uid in circleData(ids[2]).memberIds
        && request.auth.uid in circleData(ids[3]).memberIds
        && !(request.auth.uid in circleData(ids[0]).get('omitWriteIds', []))
        && !(request.auth.uid in circleData(ids[1]).get('omitWriteIds', []))
        && !(request.auth.uid in circleData(ids[2]).get('omitWriteIds', []))
        && !(request.auth.uid in circleData(ids[3]).get('omitWriteIds', []))
        && data.userId in data.memberIds
        && data.memberIds.hasOnly(audience)
        && audience.removeAll(data.memberIds).hasOnly(omitted);
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'userId',
          'displayName',
          'username',
          'photoURL',
          'defaultReminderMinutes',
          'notificationsEnabled',
          'preferredFocusWindow',
          'prefersQuickWinsFirst',
          'behaviorSignals',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'displayName',
          'username',
          'photoURL',
          'defaultReminderMinutes',
          'notificationsEnabled',
          'preferredFocusWindow',
          'prefersQuickWinsFirst',
          'behaviorSignals',
          'addressName',
          'voiceMuted',
          'emailEnabled',
          'mailFromPeople',
          'mailBills',
          'mailNewsletters',
          'mailOnlySenders',
          'mailNeverSenders',
          'vaultSalt',
          'vaultCheck',
          'vaultRecoveryWrap',
          'vaultRecoveryCheck',
          'wrapPublicKey',
          'wrapPrivateSealed',
          'aiAccess',
          'aiConnectors',
          'aiWrite',
          'sealedKinds',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('addressName' in data)
          || (data.addressName is string && data.addressName.size() <= 80))
        && (!('voiceMuted' in data) || data.voiceMuted is bool)
        && (!('emailEnabled' in data) || data.emailEnabled is bool)
        && (!('mailFromPeople' in data) || data.mailFromPeople is bool)
        && (!('mailBills' in data) || data.mailBills is bool)
        && (!('mailNewsletters' in data) || data.mailNewsletters is bool)
        && (!('mailOnlySenders' in data)
          || (data.mailOnlySenders is string && data.mailOnlySenders.size() <= 500))
        && (!('mailNeverSenders' in data)
          || (data.mailNeverSenders is string && data.mailNeverSenders.size() <= 500))
        && data.displayName is string
        && data.displayName.size() <= 120
        && isValidHandle(data.username)
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.defaultReminderMinutes is number
        && data.defaultReminderMinutes >= 0
        && data.defaultReminderMinutes <= 43200
        && data.notificationsEnabled is bool
        && data.preferredFocusWindow in ['morning', 'afternoon', 'evening', 'balanced']
        && data.prefersQuickWinsFirst is bool
        && isBoundedStringList(data.behaviorSignals, 30, 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('vaultSalt' in data) || (data.vaultSalt is string && data.vaultSalt.size() <= 64))
        && (!('vaultCheck' in data) || (data.vaultCheck is string && data.vaultCheck.size() <= 400))
        && (!('vaultRecoveryWrap' in data) || (data.vaultRecoveryWrap is string && data.vaultRecoveryWrap.size() <= 400))
        && (!('vaultRecoveryCheck' in data) || (data.vaultRecoveryCheck is string && data.vaultRecoveryCheck.size() <= 400))
        && (!('wrapPublicKey' in data) || (data.wrapPublicKey is string && data.wrapPublicKey.size() <= 2000))
        && (!('wrapPrivateSealed' in data) || (data.wrapPrivateSealed is string && data.wrapPrivateSealed.size() <= 2400))
        && (!('aiAccess' in data) || data.aiAccess is bool)
        && (!('aiConnectors' in data) || data.aiConnectors is bool)
        && (!('aiWrite' in data) || data.aiWrite is bool)
        && (!('sealedKinds' in data) || isBoundedStringList(data.sealedKinds, 6, 20));
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserHandle(data) {
      return data.keys().hasAll(['userId', 'username', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'username', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidHandle(data.username)
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScheduleTask(data) {
      return data.keys().hasAll([
          'userId',
          'householdId',
          'memberIds',
          'title',
          'type',
          'category',
          'dueDate',
          'dueTime',
          'estimatedMinutes',
          'reminderMinutes',
          'status',
          'priority',
          'notes',
          'helpSteps',
          'linkedDocumentId',
          'completedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'householdId',
          'memberIds',
          'ownerIds',
          'giftLog',
          'title',
          'type',
          'category',
          'dueDate',
          'dueTime',
          'estimatedMinutes',
          'reminderMinutes',
          'status',
          'priority',
          'notes',
          'helpSteps',
          'linkedDocumentId',
          'place',
          'completionState',
          'remainderNote',
          'completedAtIso',
                    'scope',
          'familyId',
          'circleIds',
          'encrypted',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && (data.userId == request.auth.uid
          || (data.householdId.size() > 0
            && data.userId in data.memberIds
            && request.auth.uid in data.memberIds))
        && isValidHouseholdStamp(data, 'tasks')
        && (!('scope' in data) || data.scope in ['private', 'household', 'family', 'circles'])
        && (!('familyId' in data) || (data.familyId is string && data.familyId.size() <= 128))
        && (!('allowPartnerFinances' in data) || data.allowPartnerFinances is bool)
        && (!('circleIds' in data) || isBoundedStringList(data.circleIds, 4, 128))
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.type in ['task', 'appointment']
        && isValidCategory(data.category)
        && data.dueDate is string
        && data.dueDate.size() == 10
        && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dueTime is string
        && data.dueTime.size() <= 10
        && data.estimatedMinutes is number
        && data.estimatedMinutes >= 5
        && data.estimatedMinutes <= 1440
        && data.reminderMinutes is number
        && data.reminderMinutes >= 0
        && data.reminderMinutes <= 43200
        && data.status in ['pending', 'completed']
        && data.priority in ['low', 'medium', 'high']
        && data.notes is string
        && data.notes.size() <= 3000
        && isBoundedStringList(data.helpSteps, 15, 400)
        && data.linkedDocumentId is string
        && data.get('place', '') is string
        && data.get('place', '').size() <= 60
        && data.get('completionState', 'finished') in ['finished', 'more']
        && data.get('remainderNote', '') is string
        && data.get('remainderNote', '').size() <= 300
        && data.linkedDocumentId.size() <= 128
        && data.completedAtIso is string
        && data.completedAtIso.size() <= 40
        && (!('ownerIds' in data) || isBoundedStringList(data.ownerIds, 20, 128))
        && (!('giftLog' in data) || (data.giftLog is list && data.giftLog.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('encrypted' in data) || data.encrypted is bool);
    }

    function isValidScannedDocument(data) {
      return data.keys().hasAll([
          'userId',
          'householdId',
          'memberIds',
          'title',
          'category',
          'ocrText',
          'summary',
          'tags',
          'keyDetails',
          'detectedDate',
          'imageUrl',
          'fileName',
          'notes',
          'verificationStatus',
          'verifiedByName',
          'verifiedAtIso',
          'paperLocation',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'householdId',
          'memberIds',
          'ownerIds',
          'giftLog',
          'title',
          'category',
          'ocrText',
          'summary',
          'tags',
          'keyDetails',
          'detectedDate',
          'imageUrl',
          'fileName',
          'notes',
          'verificationStatus',
          'verifiedByName',
          'verifiedAtIso',
          'driveFileId',
          'paperLocation',
          'place',
                    'scope',
          'familyId',
          'circleIds',
          'subjectName',
          'subjectFamilyId',
          'encrypted',
          'accountLocation',
          'recordKind',
          'customKindLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && (data.userId == request.auth.uid
          || (data.householdId.size() > 0
            && data.userId in data.memberIds
            && request.auth.uid in data.memberIds))
        && isValidHouseholdStamp(data, 'other')
        && (!('scope' in data) || data.scope in ['private', 'household', 'family', 'circles'])
        && (!('familyId' in data) || (data.familyId is string && data.familyId.size() <= 128))
        && (!('recordKind' in data) || data.recordKind in ['financial', 'medical', 'calendar', 'personal', 'custom', 'official'])
        && (!('customKindLabel' in data) || (data.customKindLabel is string && data.customKindLabel.size() <= 60))
        && (!('circleIds' in data) || isBoundedStringList(data.circleIds, 4, 128))
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && isValidCategory(data.category)
        && data.ocrText is string
        && data.ocrText.size() <= 100000
        && data.summary is string
        && data.summary.size() <= 1600
        && isBoundedStringList(data.tags, 20, 40)
        && isBoundedStringList(data.keyDetails, 25, 400)
        && data.detectedDate is string
        && data.detectedDate.size() <= 20
        && data.imageUrl is string
        && data.imageUrl.size() <= 500
        && data.fileName is string
        && data.fileName.size() <= 200
        && data.notes is string
        && data.notes.size() <= 3000
        && data.verificationStatus in ['provisional', 'verified']
        && data.verifiedByName is string
        && data.verifiedByName.size() <= 120
        && data.verifiedAtIso is string
        && data.verifiedAtIso.size() <= 40
        && (data.verificationStatus == 'provisional' || data.verifiedAtIso.size() > 0)
        && data.paperLocation is string
        && data.paperLocation.size() <= 200
        && data.get('driveFileId', '') is string
        && data.get('place', '') is string
        && data.get('place', '').size() <= 60
        && data.get('driveFileId', '').size() <= 128
        && (!('ownerIds' in data) || isBoundedStringList(data.ownerIds, 20, 128))
        && (!('giftLog' in data) || (data.giftLog is list && data.giftLog.size() <= 20))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 120))
        && (!('subjectFamilyId' in data) || (data.subjectFamilyId is string && data.subjectFamilyId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('encrypted' in data) || data.encrypted is bool)
        && (!('accountLocation' in data) || (data.accountLocation is string && data.accountLocation.size() <= 200));
    }

    function isValidVoiceMemory(data) {
      return data.keys().hasAll([
          'userId',
          'summary',
          'followUpSteps',
          'completedTaskTitles',
          'transcriptExcerpt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'summary',
          'followUpSteps',
          'completedTaskTitles',
          'transcriptExcerpt',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 1500
        && isBoundedStringList(data.followUpSteps, 15, 300)
        && isBoundedStringList(data.completedTaskTitles, 20, 200)
        && data.transcriptExcerpt is string
        && data.transcriptExcerpt.size() <= 15000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // A note for Jason: a request the desk could not fill, written down
    // for Jason instead of dead-ending (Jason's ruling, 2026-11-20).
    // Household-stamped like the other records so Jason, as a household
    // member, sees the notes Mom's desk leaves for him.
    function isValidJasonNote(data) {
      return data.keys().hasAll([
          'userId',
          'householdId',
          'memberIds',
          'text',
          'source',
          'handled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'householdId',
          'memberIds',
          'ownerIds',
          'giftLog',
          'text',
          'source',
          'handled',
                    'scope',
          'familyId',
          'circleIds',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && isValidHouseholdStamp(data, 'other')
        && (!('scope' in data) || data.scope in ['private', 'household', 'family', 'circles'])
        && (!('familyId' in data) || (data.familyId is string && data.familyId.size() <= 128))
        && (!('circleIds' in data) || isBoundedStringList(data.circleIds, 4, 128))
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 2000
        && data.source in ['front_door', 'assistant', 'voice']
        && data.handled is bool
        && (!('ownerIds' in data) || isBoundedStringList(data.ownerIds, 20, 128))
        && (!('giftLog' in data) || (data.giftLog is list && data.giftLog.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMorningBriefing(data) {
      return data.keys().hasAll([
          'userId',
          'householdId',
          'memberIds',
          'dateKey',
          'text',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'householdId',
          'memberIds',
          'dateKey',
          'text',
                    'scope',
          'familyId',
          'circleIds',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && isValidHouseholdStamp(data, 'other')
        && (!('scope' in data) || data.scope in ['private', 'household', 'family', 'circles'])
        && (!('familyId' in data) || (data.familyId is string && data.familyId.size() <= 128))
        && (!('circleIds' in data) || isBoundedStringList(data.circleIds, 4, 128))
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 4000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMailBriefing(data) {
      return data.keys().hasAll([
          'userId',
          'householdId',
          'dateKey',
          'text',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
