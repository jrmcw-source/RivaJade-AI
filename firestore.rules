        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 120))
        && (!('subjectFamilyId' in data) || (data.subjectFamilyId is string && data.subjectFamilyId.size() <= 128))
        && (!('decidedByIds' in data) || isBoundedStringList(data.decidedByIds, 8, 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedList(data) {
  return data.keys().hasAll(['userId', 'householdId', 'memberIds', 'title', 'items', 'createdAt', 'updatedAt'])
    && data.keys().hasOnly(['userId', 'householdId', 'memberIds', 'scope', 'familyId', 'circleIds', 'title', 'items', 'createdAt', 'updatedAt'])
    && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
    && data.householdId is string && data.householdId.size() <= 128
    && data.memberIds is list && data.memberIds.size() <= 100
    && (!('scope' in data) || data.scope == 'private' || data.scope == 'household' || data.scope == 'family' || data.scope == 'circles')
    && (!('familyId' in data) || (data.familyId is string && data.familyId.size() <= 128))
    && (!('circleIds' in data) || (data.circleIds is list && data.circleIds.size() <= 50))
    && data.title is string && data.title.size() > 0 && data.title.size() <= 200
    && data.items is list && data.items.size() <= 300;
}

function isValidChildProposal(data) {
  return data.keys().hasAll(['kind', 'familyId', 'subjectName', 'decidedByIds', 'proposedBy', 'proposedByName', 'status', 'approvals', 'declines', 'createdAt', 'updatedAt'])
    && data.keys().hasOnly(['kind', 'familyId', 'subjectName', 'decidedByIds', 'proposedBy', 'proposedByName', 'sheetId', 'sheetPayload', 'rosterPayload', 'status', 'approvals', 'declines', 'createdAt', 'updatedAt'])
    && (data.kind == 'sheet' || data.kind == 'roster')
    && data.familyId is string && data.familyId.size() > 0 && data.familyId.size() <= 128
    && data.subjectName is string && data.subjectName.size() > 0 && data.subjectName.size() <= 200
    && data.decidedByIds is list && data.decidedByIds.size() <= 50
    && data.proposedBy is string && data.proposedBy.size() > 0 && data.proposedBy.size() <= 128
    && data.proposedByName is string && data.proposedByName.size() <= 200
    && (!('sheetId' in data) || (data.sheetId is string && data.sheetId.size() <= 128))
    && (!('sheetPayload' in data) || data.sheetPayload is map)
    && (!('rosterPayload' in data) || data.rosterPayload is map)
    && (data.status == 'open' || data.status == 'approved' || data.status == 'declined' || data.status == 'done')
    && data.approvals is list && data.approvals.size() <= 50
    && data.declines is list && data.declines.size() <= 50;
}

function isValidGiveProposal(data) {
      return data.keys().hasAll([
          'collectionName',
          'recordId',
          'recordTitle',
          'ownerIds',
          'proposedBy',
          'proposedByName',
          'toUid',
          'toFamilyId',
          'toLabel',
          'approvals',
          'declines',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'collectionName',
          'recordId',
          'recordTitle',
          'ownerIds',
          'proposedBy',
          'proposedByName',
          'toUid',
          'toFamilyId',
          'toLabel',
          'approvals',
          'declines',
          'status',
          'decision',
          'createdAt',
          'updatedAt'
        ])
        && data.collectionName in ['documents', 'tasks', 'propertyEntries', 'financeEntries', 'jasonNotes', 'accountRecords']
        && data.recordId is string && data.recordId.size() <= 128
        && data.recordTitle is string && data.recordTitle.size() <= 200
        && isBoundedStringList(data.ownerIds, 20, 128)
        && data.ownerIds.size() >= 1
        && isValidId(data.proposedBy)
        && data.proposedByName is string && data.proposedByName.size() <= 120
        && data.toUid is string && data.toUid.size() <= 128
        && data.toFamilyId is string && data.toFamilyId.size() <= 128
        && data.toLabel is string && data.toLabel.size() >= 1 && data.toLabel.size() <= 120
        && isBoundedStringList(data.approvals, 20, 128)
        && isBoundedStringList(data.declines, 20, 128)
        && data.status in ['open', 'approved', 'declined', 'done']
        && (!('decision' in data) || data.decision in ['majority', 'eldest'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCircle(data) {
      return data.keys().hasAll([
          'name',
          'ownerId',
          'memberIds',
          'temporary',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'ownerId',
          'memberIds',
          'temporary',
          'expiresAtKey',
          'headMode',
          'headIds',
          'omitViewIds',
          'omitWriteIds',
          'omitKinds',
          'restoreDirective',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && isValidId(data.ownerId)
        && isBoundedStringList(data.memberIds, 50, 128)
        && data.memberIds.size() >= 1
        && data.ownerId in data.memberIds
        && data.temporary is bool
        && (!('expiresAtKey' in data)
          || (data.expiresAtKey is string && data.expiresAtKey.size() == 10))
        && (!('headMode' in data) || data.headMode in ['seniority', 'chosen'])
        && (!('headIds' in data) || isBoundedStringList(data.headIds, 2, 128))
        && (!('omitViewIds' in data) || isBoundedStringList(data.omitViewIds, 50, 128))
        && (!('omitWriteIds' in data) || isBoundedStringList(data.omitWriteIds, 50, 128))
        && (!('omitKinds' in data) || isBoundedStringList(data.omitKinds, 5, 20))
        && (!('restoreDirective' in data) || (data.restoreDirective is map && data.restoreDirective.keys().hasOnly(['snapshotExportedAtIso', 'atIso', 'byName'])))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHousehold(data) {
      return data.keys().hasAll([
          'householdId',
          'name',
          'ownerId',
          'ownerName',
          'memberIds',
          'invitedEmails',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'householdId',
          'name',
          'ownerId',
          'ownerName',
          'memberIds',
          'invitedEmails',
          'calendarToken',
                    'familyId',
          'allowPartnerFinances',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.householdId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && isValidId(data.ownerId)
        && data.ownerName is string
        && data.ownerName.size() <= 120
        && isBoundedStringList(data.memberIds, 25, 128)
        && data.memberIds.size() >= 1
        && data.ownerId in data.memberIds
        && isBoundedStringList(data.invitedEmails, 25, 254)
        && data.get('calendarToken', '') is string
        && data.get('calendarToken', '').size() <= 64
        && data.get('familyId', '') is string
        && data.get('familyId', '').size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHouseholdMember(data) {
      return data.keys().hasAll([
          'userId',
          'householdId',
          'householdOwnerId',
          'displayName',
          'username',
          'role',
          'memberIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'householdId',
          'householdOwnerId',
          'displayName',
          'username',
          'role',
          'memberIds',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && isValidId(data.householdId)
        && isValidId(data.householdOwnerId)
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.username is string
        && data.username.size() <= 40
        && data.role in ['owner', 'member']
        && isBoundedStringList(data.memberIds, 25, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isProjectMember(projectId) {
      return isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'username',
          'photoURL',
          'defaultReminderMinutes',
          'notificationsEnabled',
          'preferredFocusWindow',
          'prefersQuickWinsFirst',
          'behaviorSignals',
          'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if false;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }

    match /userHandles/{handle} {
      allow get: if isSignedIn() && isValidHandle(handle);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidHandle(handle)
        && isValidUserHandle(incoming())
        && incoming().username == handle
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidHandle(handle)
        && isValidUserHandle(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidHandle(handle) && existing().userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && canAccessRecord();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(taskId)
        && isValidScheduleTask(incoming())
        && (incoming().householdId == '' || isHouseholdMember(incoming().householdId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(taskId)
        && isValidScheduleTask(incoming())
        && (existing().userId == request.auth.uid || isHouseholdMember(existingHouseholdId()))
        && incoming().userId == existing().userId
        && incoming().householdId == existingHouseholdId()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().status == 'pending'
            && incoming().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'type',
              'category',
              'dueDate',
              'dueTime',
              'estimatedMinutes',
              'reminderMinutes',
              'priority',
              'notes',
              'helpSteps',
              'linkedDocumentId',
              'place',
              'householdId',
              'memberIds',
              'updatedAt'
            ]))
          ||
          (existing().status == 'pending'
            && incoming().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['helpSteps', 'householdId', 'memberIds', 'updatedAt']))
          ||
          (existing().status == 'pending'
            && incoming().status == 'completed'
            && incoming().completedAtIso.size() > 0
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAtIso', 'householdId', 'memberIds', 'updatedAt']))
          ||
          (existing().status == 'completed'
            && incoming().status == 'pending'
            && incoming().completedAtIso == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAtIso', 'householdId', 'memberIds', 'updatedAt']))
          ||
          (existingHouseholdId().size() > 0
            && isHouseholdMember(existingHouseholdId())
            && incoming().memberIds == householdData(existingHouseholdId()).memberIds
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt']))
        );
      allow update: if isVerifiedUser()
        && isValidId(taskId)
        && isValidScheduleTask(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().householdId == existing().householdId
        && incoming().updatedAt == request.time
        && (existing().userId == request.auth.uid
          || (('ownerIds' in existing()) && request.auth.uid in existing().ownerIds))
        && incoming().userId in incoming().memberIds
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'ownerIds', 'memberIds', 'giftLog', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(taskId)
        && (existing().userId == request.auth.uid
          || (existingHouseholdId().size() > 0
            && isHouseholdMember(existingHouseholdId())
            && householdData(existingHouseholdId()).ownerId == request.auth.uid));
    }

    match /documents/{documentId} {
      allow get: if isSignedIn() && isValidId(documentId) && canAccessRecord();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(documentId)
        && isValidScannedDocument(incoming())
        && (incoming().householdId == '' || isHouseholdMember(incoming().householdId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(documentId)
        && isValidScannedDocument(incoming())
        && (existing().userId == request.auth.uid || isHouseholdMember(existingHouseholdId()))
        && incoming().userId == existing().userId
        && incoming().householdId == existingHouseholdId()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'category',
          'ocrText',
          'summary',
          'tags',
          'keyDetails',
          'detectedDate',
          'notes',
          'verificationStatus',
          'verifiedByName',
          'verifiedAtIso',
          'driveFileId',
          'place',
          'paperLocation',
          'householdId',
          'subjectName',
          'subjectFamilyId',
          'memberIds',
          'updatedAt'
        ])
        || (existingHouseholdId().size() > 0
          && isHouseholdMember(existingHouseholdId())
          && incoming().memberIds == householdData(existingHouseholdId()).memberIds
          && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])));
      allow update: if isVerifiedUser()
        && isValidId(documentId)
        && isValidScannedDocument(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().householdId == existing().householdId
        && incoming().updatedAt == request.time
        && (existing().userId == request.auth.uid
          || (('ownerIds' in existing()) && request.auth.uid in existing().ownerIds))
        && incoming().userId in incoming().memberIds
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'ownerIds', 'memberIds', 'giftLog', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(documentId)
        && (existing().userId == request.auth.uid
          || (existingHouseholdId().size() > 0
            && isHouseholdMember(existingHouseholdId())
            && householdData(existingHouseholdId()).ownerId == request.auth.uid));
    }

    match /accountRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && canAccessRecord();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(recordId)
        && isValidAccountRecord(incoming())
        && incoming().userId == request.auth.uid
        && (incoming().householdId == '' || isHouseholdMember(incoming().householdId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(recordId)
        && isValidAccountRecord(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().householdId == existing().householdId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'username',
          'url',
          'credentialId',
          'memberIds',
          'scope',
          'familyId',
          'circleIds',
          'updatedAt'
        ]);
      allow update: if isVerifiedUser()
        && isValidId(recordId)
        && isValidAccountRecord(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().householdId == existing().householdId
        && incoming().updatedAt == request.time
        && (existing().userId == request.auth.uid
          || (('ownerIds' in existing()) && request.auth.uid in existing().ownerIds))
        && incoming().userId in incoming().memberIds
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'ownerIds', 'memberIds', 'giftLog', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(recordId)
        && (existing().userId == request.auth.uid
          || (existingHouseholdId().size() > 0
            && isHouseholdMember(existingHouseholdId())
            && householdData(existingHouseholdId()).ownerId == request.auth.uid));
    }

    match /credentials/{credentialId} {
      // The credentials box: its own store, its own rules. The
      // owner alone writes. A read reaches the owner, or a member
      // of the account's audience — and the family wrap is the only
      // copy a member can actually open.
      allow get: if isSignedIn() && isValidId(credentialId)
        && (existing().ownerId == request.auth.uid || request.auth.uid in existing().memberIds);
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(credentialId)
        && isValidCredential(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(credentialId)
        && isValidCredential(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().accountRecordId == existing().accountRecordId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'passwordSealed',
          'passwordFamilyWrap',
          'notesSealed',
          'aiUse',
          'memberIds',
          'familyId',
          'updatedAt'
        ]);
      allow update: if isVerifiedUser()
        && isValidId(credentialId)
        && isValidCredential(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().accountRecordId == existing().accountRecordId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().ownerId in incoming().memberIds
        && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'memberIds', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(credentialId)
        && existing().ownerId == request.auth.uid;
    }

    match /directoryEntries/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && canAccessRecord();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidDirectoryEntry(incoming())
        && incoming().userId == request.auth.uid
        && (incoming().householdId == '' || isHouseholdMember(incoming().householdId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && isValidDirectoryEntry(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().householdId == existing().householdId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'birthday',
          'anniversary',
          'anniversaryLabel',
          'physicalAddress',
          'billingAddress',
          'phones',
          'emails',
          'notes',
          'memberIds',
          'scope',
          'familyId',
          'circleIds',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(entryId)
        && existing().userId == request.auth.uid;
    }

    match /emergencySheets/{sheetId} {
      allow get: if isSignedIn() && isValidId(sheetId) && canAccessRecord();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(sheetId)
        && isValidEmergencySheet(incoming())
        && incoming().userId == request.auth.uid
        && (incoming().householdId == '' || isHouseholdMember(incoming().householdId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(sheetId)
        && isValidEmergencySheet(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().householdId == existing().householdId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'forName',
          'contacts',
          'doctors',
          'allergies',
          'medicationsNote',
          'bloodType',
          'conditionsNote',
          'wishes',
          'careNotes',
          'notes',
          'memberIds',
          'scope',
          'familyId',
          'circleIds',
          'subjectName',
          'subjectFamilyId',
          'decidedByIds',
          'updatedAt'
        ])
        // A parent or guardian who did not write the sheet still
        // decides for their child (Jason, 2026-11-21): they may
        // update its words and its reach.
        || (isVerifiedUser()
        && isValidId(sheetId)
        && isValidEmergencySheet(incoming())
        && request.auth.uid in existing().get('decidedByIds', [])
        && incoming().userId == existing().userId
        && incoming().householdId == existing().householdId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'forName',
          'contacts',
          'doctors',
          'allergies',
          'medicationsNote',
          'bloodType',
          'conditionsNote',
          'wishes',
          'careNotes',
          'notes',
          'memberIds',
          'scope',
          'familyId',
          'circleIds',
          'subjectName',
          'subjectFamilyId',
          'decidedByIds',
          'updatedAt'
        ]));
      allow delete: if isVerifiedUser() && isValidId(sheetId)
        && existing().userId == request.auth.uid;
    }

    match /sharedLists/{listId} {
      // One list at a reach, like every other record. The owner
      // keeps it; anyone in the audience can check an item off —
      // that is what a shared list is for.
      allow get: if isSignedIn() && isValidId(listId)
        && (existing().userId == request.auth.uid
          || request.auth.uid in existing().memberIds);
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isVerifiedUser()
        && isValidId(listId)
        && isValidSharedList(incoming())
        && incoming().userId == request.auth.uid
        && (incoming().householdId == '' || isHouseholdMember(incoming().householdId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(listId)
        && isValidSharedList(incoming())
