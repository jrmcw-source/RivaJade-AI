    match /childProposals/{proposalId} {
      // Equal custody's joint act: the child's deciders read the
      // proposal; the other parent's confirmation is what moves
      // the record. Votes only grow; the payload never changes.
      allow get: if isSignedIn() && isValidId(proposalId)
        && (request.auth.uid in existing().decidedByIds
          || existing().proposedBy == request.auth.uid);
      allow list: if isSignedIn()
        && (request.auth.uid in resource.data.get('decidedByIds', [])
